# Copy to .env for local runs (python main.py ...). In GitHub, add these as repository
# secrets instead (Settings -> Secrets and variables -> Actions). Never commit .env.

# Telegram: create a bot with @BotFather -> token. Chat id: message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini free tier key: https://aistudio.google.com/apikey  (leave empty to run without AI)
GEMINI_API_KEY=

# Optional fallback provider (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Google Calendar -> Settings -> your calendar -> "Secret address in iCal format".
# Treat it like a password. Leave empty to skip the calendar section.
CALENDAR_ICAL_URL=

# Real Madrid scores/fixtures - free key (instant): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Optional Todoist: Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# Optional: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
